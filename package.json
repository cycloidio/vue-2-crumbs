{
  "name": "vue-2-crumbs",
  "version": "0.5.5",
  "description": "Breadcrumbs plugin for Vue.js 2 framework that allows to select parent route in route meta object with no need of sub-routing",
  "author": {
    "name": "Alexeev Kyrylo",
    "email": "suruat90@gmail.com"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "breadcrumbs",
    "vue",
    "vuejs",
    "vue2",
    "plugin",
    "route",
    "router",
    "vue-router"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Suruat/vue-2-crumbs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suruat/vue-2-crumbs.git"
  },
  "bugs": "https://github.com/Suruat/vue-2-crumbs/issues",
  "devDependencies": {
    "tsdown": "^0.12.7",
    "unplugin-vue2": "^0.1.1"
  },
  "scripts": {
    "dev2": "npm -w playground/vue2 run dev",
    "build": "tsdown",
    "prepare": "npm run build"
  },
  "workspaces": [
    "playground/vue2",
    "src"
  ],
  "dependencies": {
    "es-toolkit": "^1.39.3",
    "mitt": "^3.0.1"
  }
}
